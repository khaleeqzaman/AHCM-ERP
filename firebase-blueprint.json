{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, contact, and system status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "purchaser", "cashier", "accountant", "store_manager"] },
        "department": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "lastLogin": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "username", "name", "role", "status"]
    },
    "DemandDocument": {
      "title": "DemandDocument",
      "description": "Procurement monthly demand document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "demandType": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 30 },
        "referenceNo": { "type": "string", "maxLength": 50 },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Finalized", "Submitted for Approval", "Approved", "Rejected"] },
        "adminRemark": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "demandType", "category", "date", "referenceNo", "totalAmount", "status"]
    },
    "PurchaseDocument": {
      "title": "PurchaseDocument",
      "description": "Purchase order and vendor billing document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "supplierName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "paymentType": { "type": "string", "maxLength": 50 },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Finalized", "Submitted for Approval", "Approved", "Rejected"] },
        "adminRemark": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "orderNumber", "supplierName", "date", "paymentType", "totalAmount", "status"]
    },
    "VoucherDocument": {
      "title": "VoucherDocument",
      "description": "Financial accounting voucher record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "voucherNumber": { "type": "string", "maxLength": 50 },
        "voucherType": { "type": "string", "enum": ["CPV", "CRV", "BPV", "BRV", "JV"] },
        "date": { "type": "string", "maxLength": 30 },
        "description": { "type": "string", "maxLength": 255 },
        "totalDebit": { "type": "number" },
        "totalCredit": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Posted", "Void"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "voucherNumber", "voucherType", "date", "totalDebit", "totalCredit", "status"]
    },
    "CashBookEntry": {
      "title": "CashBookEntry",
      "description": "Cash book daily disbursement or receipt record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "voucherNo": { "type": "string", "maxLength": 50 },
        "accountHead": { "type": "string", "maxLength": 100 },
        "particulars": { "type": "string", "maxLength": 255 },
        "debit": { "type": "number" },
        "credit": { "type": "number" },
        "balance": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "date", "accountHead", "particulars"]
    },
    "PosCoalSale": {
      "title": "PosCoalSale",
      "description": "Store point of sale invoice for coal deliveries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "invoiceNo": { "type": "string", "maxLength": 50 },
        "buyerName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "totalWeight": { "type": "number" },
        "netAmount": { "type": "number" },
        "paymentMode": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "invoiceNo", "buyerName", "date", "totalWeight", "netAmount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and permissions collection"
    },
    "/demands/{demandId}": {
      "schema": "DemandDocument",
      "description": "Procurement monthly demand requests"
    },
    "/purchases/{purchaseId}": {
      "schema": "PurchaseDocument",
      "description": "Purchase orders and bills"
    },
    "/vouchers/{voucherId}": {
      "schema": "VoucherDocument",
      "description": "Accounting double-entry vouchers"
    },
    "/cash_book_entries/{entryId}": {
      "schema": "CashBookEntry",
      "description": "Treasury cash in hand transactions"
    },
    "/pos_coal_sales/{saleId}": {
      "schema": "PosCoalSale",
      "description": "Store coal sales invoices"
    }
  }
}
