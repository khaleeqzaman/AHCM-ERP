# ====================================================================
# SUPABASE / POSTGRESQL CONFIGURATION
# ====================================================================

# 1. Supabase Direct Database Connection (Recommended for Drizzle ORM backend)
# Obtain this from your Supabase Dashboard -> Project Settings -> Database -> Connection String (URI).
# Example (Direct connection on port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
#
# Or with Supabase Transaction Connection Pooler (Port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Optional alternative: Individual host/port/credentials (if not using DATABASE_URL)
# SQL_HOST="db.[PROJECT-REF].supabase.co"
# SQL_PORT=5432
# SQL_DB_NAME="postgres"
# SQL_USER="postgres"
# SQL_PASSWORD="your-strong-supabase-password"

# 2. Supabase API & SDK Credentials (for @supabase/supabase-js)
# Obtain these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Client-side exposed Supabase variables (Vite prefix)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ====================================================================
# APP & AI PLATFORM CONFIGURATION
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000
